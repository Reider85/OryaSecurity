# Database configuration
POSTGRES_DB=scanner
POSTGRES_USER=scanner
POSTGRES_PASSWORD=scanner

# Scanner configuration
API_KEY_DEFAULT=dev-key-12345
# JWT for UI auth (API-key -> JWT exchange). Change in production.
JWT_SECRET=dev-secret-change-me-0123456789abcdef0123456789abcdef
JWT_TTL_SECONDS=86400
LLM_PROVIDER_URL=https://api.z.ai/api/paas/v4
LLM_API_KEY=your-zai-api-key
LLM_MODEL=glm-5.3-flash
LLM_API_PATH=/chat/completions
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=300
DEFAULT_TENANT_ID=default
PDP_DEFAULT_ACTION=allow
PDP_BLOCK_ON_SEVERITY=["high","critical"]
AUDIT_ENABLED=true
REDACT_AUDIT_PROMPT=true
POLICY_VERSION=mvp-1.0
LLM_TIMEOUT_SECONDS=30
RATE_LIMIT_RPS=100
# Rules are loaded from backend/rules (mounted into the scanner container at /app/rules)
RULES_DIR=rules

# Observability (optional, use --profile observability)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Frontend (optional, use --profile ui)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Triton Inference Server (optional, for EP-08 embedding service)
# SCANNER_TRITON_URL=http://localhost:8001  # gRPC URL for Triton
# SCANNER_TRITON_MODEL_NAME=multilingual_e5
# SCANNER_TRITON_TIMEOUT_MS=2000

# Qdrant Vector DB (optional, for EP-09 vector search)
# SCANNER_QDRANT_URL=http://localhost:6333
# SCANNER_QDRANT_COLLECTION=prompt_attacks
# SCANNER_QDRANT_TOP_K=10
# SCANNER_TEST_QDRANT_URL=http://127.0.0.1:6333  # For integration tests

# MinIO / S3 for Qdrant snapshots (EP-09/Prompt 15, backend/scripts/qdrant_backup.sh)
# Dev defaults match docker-compose.alpha.yml — change for production.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# aws CLI credentials (dev defaults = MinIO root user)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=qdrant-backups
S3_PREFIX=qdrant/snapshots
# Qdrant nodes to snapshot (comma-separated; alpha cluster = 3 nodes)
QDRANT_URLS=http://localhost:6333,http://localhost:6343,http://localhost:6353
# Backup runs to keep in S3 (one run every 6h => ~42h of history)
SNAPSHOT_KEEP=7

# HashiCorp Vault PII redaction (EP-13/Prompt 31, backend/scripts/vault_init.sh)
# Dev-mode root token (docker compose --profile dev up vault)
VAULT_DEV_ROOT_TOKEN=dev-token
# Root token written by vault_init.sh to backend/scripts/.vault-secrets/vault.env
# (export VAULT_TOKEN or add it here before starting the alpha stack)
# VAULT_TOKEN=
# Secrets engine mount path (tokenization on Vault Enterprise, transit fallback on OSS)
VAULT_MOUNT=tokenization
# Token TTL / auto-cleanup (EP-13/Prompt 34): the vault-cleanup service rotates
# the encode key every VAULT_TOKEN_TTL_SECONDS and keeps the previous key
# version decryptable (grace), so minted PII tokens die after (interval, 2*interval]
# — 5..10 minutes with the 300s default.
VAULT_TOKEN_TTL_SECONDS=300
VAULT_TOKEN_TTL_GRACE_VERSIONS=1
# Scanner integration (set automatically by docker-compose.alpha.yml)
# SCANNER_VAULT_URL=http://localhost:8200
# SCANNER_VAULT_TOKEN=

# Presidio NER for non-standard PII (EP-13/Prompt 35)
# Requires the optional extra: pip install -e "backend[ner]"
# SCANNER_PRESIDIO_ENABLED=false
# SCANNER_PRESIDIO_LANGUAGE=ru
# SCANNER_PRESIDIO_MIN_SCORE=0.4

# Per-tenant fallback policy for the ML classifier circuit breaker
# (EP-14/Prompt 37): "default" -> degrade (rule-only),
# "strict" -> fail-closed (BLOCK + audit "ml_unavailable")
# SCANNER_TENANT_POLICIES={"acme": "strict"}

# OpenTelemetry tracing (Prompt 40)
# SCANNER_OTEL_TRACING_ENABLED=true               # Enable tracing (default true)
# SCANNER_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317  # OTLP gRPC endpoint
# SCANNER_OTEL_SERVICE_VERSION=0.2.0             # Service version for OTel Resource
# SCANNER_OTEL_SAMPLING_RATIO=1.0                 # Head sampling ratio (default 1.0 = always on)
