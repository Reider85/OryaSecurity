  "panels": [
    {
      "datasource": "Prometheus",
      "description": "Requests per second through the scanner, by verdict (allow / block / review). Filtered by the tenant_id dashboard variable.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "8.5.22",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(scanner_requests_total{tenant_id=~\"$tenant_id\"}[$__rate_interval]))",
          "interval": "",
          "legendFormat": "total",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum by (verdict) (rate(scanner_requests_total{tenant_id=~\"$tenant_id\"}[$__rate_interval]))",
          "interval": "",
          "legendFormat": "{{ verdict }}",
          "refId": "B"
        }
      ],
      "title": "RPS (requests/sec)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Request latency percentiles from scanner_request_duration_seconds (fast path + slow path combined).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "8.5.22",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(scanner_request_duration_seconds_bucket[$__rate_interval])))",
          "interval": "",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(scanner_request_duration_seconds_bucket[$__rate_interval])))",
          "interval": "",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(scanner_request_duration_seconds_bucket[$__rate_interval])))",
          "interval": "",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Latency p50 / p95 / p99",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Error/abnormal event rates as % of total scanner RPS, per type: OPA errors, post-factum errors, stream blocks, slow-path degradations, circuit breaker failures, redaction/detokenization failures.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "8.5.22",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "100 * sum by (type) (rate(scanner_pdp_opa_errors_total[$__rate_interval])) / on() group_left sum(rate(scanner_requests_total{tenant_id=~\"$tenant_id\"}[$__rate_interval]))",
          "interval": "",
          "legendFormat": "opa_error / {{ type }}",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "100 * sum(rate(scanner_post_factum_total{outcome=\"error\"}[$__rate_interval])) / on() group_left sum(rate(scanner_requests_total{tenant_id=~\"$tenant_id\"}[$__rate_interval]))",
          "interval": "",
          "legendFormat": "post_factum / error",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "100 * sum by (reason_type) (rate(scanner_stream_blocks_total[$__rate_interval])) / on() group_left sum(rate(scanner_requests_total{tenant_id=~\"$tenant_id\"}[$__rate_interval]))",
          "interval": "",
          "legendFormat": "stream_block / {{ reason_type }}",
          "refId": "C"
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "100 * sum by (component) (rate(scanner_slow_path_degraded_total[$__rate_interval])) / on() group_left sum(rate(scanner_requests_total{tenant_id=~\"$tenant_id\"}[$__rate_interval]))",
          "interval": "",
          "legendFormat": "slow_path_degraded / {{ component }}",
          "refId": "D"
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "100 * sum by (component) (rate(scanner_circuit_breaker_failures_total[$__rate_interval])) / on() group_left sum(rate(scanner_requests_total{tenant_id=~\"$tenant_id\"}[$__rate_interval]))",
          "interval": "",
          "legendFormat": "cb_failures / {{ component }}",
          "refId": "E"
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "100 * sum by (error) (rate(scanner_redaction_failures_total[$__rate_interval])) / on() group_left sum(rate(scanner_requests_total{tenant_id=~\"$tenant_id\"}[$__rate_interval]))",
          "interval": "",
          "legendFormat": "redaction_failure / {{ error }}",
          "refId": "F"
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "100 * sum by (error) (rate(scanner_detokenization_failures_total[$__rate_interval])) / on() group_left sum(rate(scanner_requests_total{tenant_id=~\"$tenant_id\"}[$__rate_interval]))",
          "interval": "",
          "legendFormat": "detokenization_failure / {{ error }}",
          "refId": "G"
        }
      ],
      "title": "Error Rate (% of RPS, per type)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Decision cache hit ratio: hits / (hits + misses) over the last 5 minutes. Target: > 30% (ALPHA exit criterion).",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 0.3
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "pluginVersion": "8.5.22",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(scanner_cache_hits_total{type=\"decision\"}[5m])) / (sum(rate(scanner_cache_hits_total{type=\"decision\"}[5m])) + sum(rate(scanner_cache_misses_total{type=\"decision\"}[5m])))",
          "interval": "",
          "legendFormat": "decision cache",
          "refId": "A"
        }
      ],
      "title": "Cache Hit Ratio",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "description": "Current circuit breaker state per component (0=CLOSED, 1=OPEN, 2=HALF_OPEN).",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "CLOSED"
                },
                "1": {
                  "color": "red",
                  "index": 1,
                  "text": "OPEN"
                },
                "2": {
                  "color": "orange",
                  "index": 2,
                  "text": "HALF_OPEN"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "component"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "footer": {
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Value"
          }
        ]
      },
      "pluginVersion": "8.5.22",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "scanner_circuit_breaker_state",
          "format": "table",
          "instant": true,
          "legendFormat": "{{ component }}",
          "refId": "A"
        }
      ],
      "title": "Circuit Breaker States",
      "type": "table"
    },
    {
      "datasource": "Loki",
      "description": "Top-5 most recent WARN/ERROR/CRITICAL scanner log events from Loki. The Trace derived field links a log line to its Jaeger trace.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 16
      },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Time"
          }
        ]
      },
      "pluginVersion": "8.5.22",
      "targets": [
        {
          "datasource": "Loki",
          "editorMode": "code",
          "expr": "{app=\"scanner\"} | json | level=~\"WARN|ERROR|CRITICAL\"",
          "maxLines": 5,
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Top-5 Alerts (Loki)",
      "type": "table"
    }
  ],
  "refresh": "5s",
