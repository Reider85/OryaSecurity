      },
      "pluginVersion": "8.5.22",
      "targets": [
        {
          "datasource": "prometheus",
          "editorMode": "code",
          "expr": "sum by (component) (rate(scanner_circuit_breaker_failures_total[5m]))",
          "interval": "",
          "legendFormat": "{{ component }}",
          "refId": "A"
        }
      ],
      "title": "Circuit Breaker Failure Rate",
      "type": "timeseries"
    },
    {
      "datasource": "prometheus",
