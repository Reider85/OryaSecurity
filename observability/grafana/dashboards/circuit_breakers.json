  "panels": [
    {
      "datasource": "prometheus",
      "description": "Current circuit breaker state per component (0=CLOSED, 1=OPEN, 2=HALF_OPEN)",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "CLOSED"
                },
                "1": {
                  "color": "red",
                  "index": 1,
                  "text": "OPEN"
                },
                "2": {
                  "color": "orange",
                  "index": 2,
                  "text": "HALF_OPEN"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "component"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "footer": {
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Value"
          }
        ]
      },
      "pluginVersion": "8.5.22",
      "targets": [
        {
          "datasource": "prometheus",
          "editorMode": "code",
          "expr": "scanner_circuit_breaker_state",
          "format": "table",
          "instant": true,
          "legendFormat": "{{ component }}",
          "refId": "A"
        }
      ],
      "title": "Circuit Breaker States",
      "type": "table"
    },
    {
      "datasource": "prometheus",
      "description": "Circuit breaker state transitions over time (0=CLOSED, 1=OPEN, 2=HALF_OPEN)",
