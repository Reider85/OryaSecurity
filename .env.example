# Database configuration
POSTGRES_DB=scanner
POSTGRES_USER=scanner
POSTGRES_PASSWORD=scanner

# Scanner configuration
API_KEY_DEFAULT=dev-key-12345
# JWT for UI auth (API-key -> JWT exchange). Change in production.
JWT_SECRET=dev-secret-change-me-0123456789abcdef0123456789abcdef
JWT_TTL_SECONDS=86400
LLM_PROVIDER_URL=https://api.z.ai/api/paas/v4
LLM_API_KEY=your-zai-api-key
LLM_MODEL=glm-5.3-flash
LLM_API_PATH=/chat/completions
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=300
DEFAULT_TENANT_ID=default
PDP_DEFAULT_ACTION=allow
PDP_BLOCK_ON_SEVERITY=["high","critical"]
AUDIT_ENABLED=true
REDACT_AUDIT_PROMPT=true
POLICY_VERSION=mvp-1.0
LLM_TIMEOUT_SECONDS=30
RATE_LIMIT_RPS=100
# Rules are loaded from backend/rules (mounted into the scanner container at /app/rules)
RULES_DIR=rules

# Observability (optional, use --profile observability)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Frontend (optional, use --profile ui)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Triton Inference Server (optional, for EP-08 embedding service)
# SCANNER_TRITON_URL=http://localhost:8001  # gRPC URL for Triton
# SCANNER_TRITON_MODEL_NAME=multilingual_e5
# SCANNER_TRITON_TIMEOUT_MS=2000

# Qdrant Vector DB (optional, for EP-09 vector search)
# SCANNER_QDRANT_URL=http://localhost:6333
# SCANNER_QDRANT_COLLECTION=prompt_attacks
# SCANNER_QDRANT_TOP_K=10
# SCANNER_TEST_QDRANT_URL=http://127.0.0.1:6333  # For integration tests