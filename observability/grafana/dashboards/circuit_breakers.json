      },
      "pluginVersion": "8.5.22",
      "targets": [
        {
          "datasource": "prometheus",
          "editorMode": "code",
          "expr": "sum by (component, mode) (increase(scanner_circuit_breaker_fallback_invocations_total[5m]))",
          "interval": "",
